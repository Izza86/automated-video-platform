/* ------------------------------------------------------------------ */
/*  UTILS                                                              */
/* ------------------------------------------------------------------ */

function formatNumber(n: number): string {
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + "M";
  if (n >= 1_000) return (n / 1_000).toFixed(1) + "K";
  return n.toString();
}

/* ------------------------------------------------------------------ */
/*  MAIN COMPONENT                                                     */
/* ------------------------------------------------------------------ */

export default function TemplatesPage() {
  const [activeCategory, setActiveCategory] = useState("all");
  const [selectedTemplate, setSelectedTemplate] = useState<TemplateItem | null>(null);
  const [step, setStep] = useState<0 | 1 | 2 | 3>(0); // 0=browse,1=upload,2=process,3=done
  const [targetFile, setTargetFile] = useState<File | null>(null);
  const [loading, setLoading] = useState(false);
  const [progress, setProgress] = useState(0);
  const [processStage, setProcessStage] = useState(0);
  const [result, setResult] = useState<any>(null);
  const [error, setError] = useState("");
  const [videoPreview, setVideoPreview] = useState<string | null>(null);

  /* ── processing animation ── */
  useEffect(() => {
    let interval: any;
    if (loading && progress < 95) {
      interval = setInterval(() => {
        setProgress((p) => {
          const next = Math.min(p + Math.random() * 5 + 1, 95);
          if (next > 20) setProcessStage(1);
          if (next > 45) setProcessStage(2);
          if (next > 75) setProcessStage(3);
          return next;
        });
      }, 600);
    }
    return () => clearInterval(interval);
  }, [loading, progress]);

  const handleApply = async () => {
    if (!targetFile || !selectedTemplate) return;
    setLoading(true);
    setStep(2);
    setError("");
    setResult(null);
    setProgress(0);
    setProcessStage(0);

    try {
      const formData = new FormData();
      formData.append("target", targetFile);
      formData.append("templateId", selectedTemplate.id);
      formData.append("outputMode", "both");

      const res = await fetch("/api/template-edit", {
        method: "POST",
        body: formData,
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || "Failed");
      setResult(data);
      setProgress(100);
      setProcessStage(4);
      setStep(3);
      toast.success("Template applied successfully!");
    } catch (err: any) {
      setError(err.message);
      setStep(1);
      toast.error(err.message);
    } finally {
      setLoading(false);
    }
  };

  const resetAll = useCallback(() => {
    setStep(0);
    setSelectedTemplate(null);
    setTargetFile(null);
    setResult(null);
    setError("");
    setProgress(0);
    setProcessStage(0);
    setVideoPreview(null);
  }, []);

  const filtered =
    activeCategory === "all"
      ? ALL_TEMPLATES
      : activeCategory === "trending"
      ? ALL_TEMPLATES.filter((t) => t.trending)
      : ALL_TEMPLATES.filter((t) => t.category === activeCategory);

  const featured = ALL_TEMPLATES.filter((t) => t.featured);

  /* ── screens ── */
  if (step === 2) {
    return (
      <ProcessingScreen
        progress={progress}
        stage={processStage}
        templateName={selectedTemplate?.name || ""}
      />
    );
  }

  if (step === 3 && result) {
    return (
      <ResultScreen
        result={result}
        template={selectedTemplate}
        onReset={resetAll}
      />
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-b from-[#0a0a0f] via-[#0f0f1a] to-[#0a0a0f] text-white overflow-x-hidden">
      {/* Ambient floating particles background */}
      <ParticleBackground />

      {/* Header */}
      <header className="sticky top-0 z-50 bg-[#0a0a0f]/80 backdrop-blur-xl border-b border-white/5">
        <div className="max-w-[1600px] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
          <div className="flex items-center gap-4">
            <Link
              href="/dashboard"
              className="flex items-center gap-2 text-purple-400 hover:text-purple-300 transition-colors"
            >
              <ArrowLeft className="w-5 h-5" />
              <span className="hidden sm:inline text-sm font-medium">Back</span>
            </Link>
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-fuchsia-500 flex items-center justify-center shadow-lg shadow-violet-500/30">
          
